{
  "name": "veilbreak",
  "version": "2.2.0",
  "description": "Zero-dependency anti-stealth, Firecrawl/AI-crawler & multi-engine browser integrity gate — 15 cross-engine invariants, active CDP fingerprinting, interaction kinematics, SRI, adjustable security presets, middleware, and Python verifier",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./presets": {
      "types": "./src/presets.d.ts",
      "default": "./src/presets.js"
    },
    "./probes": {
      "types": "./src/probes.d.ts",
      "default": "./src/probes.js"
    },
    "./middleware": {
      "types": "./src/middleware.d.ts",
      "default": "./src/middleware.js"
    },
    "./browser-sdk": {
      "types": "./src/browser-sdk.d.ts",
      "default": "./src/browser-sdk.js"
    },
    "./nl": {
      "types": "./src/nl.d.ts",
      "default": "./src/nl.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "bin/",
    "python/",
    "!python/__pycache__/**",
    "!**/*.pyc",
    "docs/",
    "assets/",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "veilbreak": "./bin/veilbreak.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HUSMUS9999/veilbreak.git"
  },
  "homepage": "https://github.com/HUSMUS9999/veilbreak#readme",
  "bugs": {
    "url": "https://github.com/HUSMUS9999/veilbreak/issues"
  },
  "scripts": {
    "test": "node --test test/veilbreak.test.js",
    "demo": "node bin/veilbreak.js demo",
    "bench": "python3 benchmarks/run_live_benchmark.py"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "anti-detect",
    "stealth-browser",
    "bot-detection",
    "browser-integrity",
    "web-components",
    "browser-fingerprinting",
    "security",
    "anti-scraping",
    "middleware",
    "zero-dependency"
  ],
  "license": "MIT"
}
